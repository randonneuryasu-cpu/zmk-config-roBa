#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100

&mt {
    flavor = "balanced";
    quick-tap-ms = <300>;
};

&lt {
    flavor = "balanced";
    quick-tap-ms = <300>;
};

&trackball {
    automouse-layer = <4>;
    scroll-layers = <5>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos {
        compatible = "zmk,combos";

        single_quotation {
            bindings = <&kp SQT>;
            key-positions = <20 21>;
        };

        scroll {
            bindings = <&mo 5>;
            key-positions = <20 19>;
        };

        RtShift {
            bindings = <&kp RIGHT_SHIFT>;
            key-positions = <18 19>;
        };

        RtWin {
            bindings = <&kp RIGHT_WIN>;
            key-positions = <33 32>;
        };

        RtAlt {
            bindings = <&kp RIGHT_ALT>;
            key-positions = <32 31>;
        };

        RtCtl {
            bindings = <&kp RIGHT_CONTROL>;
            key-positions = <30 31>;
        };

        LtShift {
            bindings = <&kp LEFT_SHIFT>;
            key-positions = <13 12>;
        };

        LtWin {
            bindings = <&kp LWIN>;
            key-positions = <22 23>;
        };

        LtAlt {
            bindings = <&kp LEFT_ALT>;
            key-positions = <23 24>;
        };

        LtCtl {
            bindings = <&kp LEFT_CONTROL>;
            key-positions = <25 24>;
        };

        Esc {
            bindings = <&kp ESCAPE>;
            key-positions = <11 12>;
        };

        RtMB2 {
            bindings = <&mkp MB2>;
            key-positions = <7 20>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        scroll_up_down: behavior_sensor_rotate_mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            // 追加: スクロールのタップ時間を設定 (20ms)

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q      &kp W         &kp F          &kp P    &kp B                                                &kp J      &kp L  &kp U      &kp Y    &kp SEMICOLON
&kp A      &kp R         &kp S          &kp T    &kp G             &none                &out OUT_BLE  &kp M      &kp N  &kp E      &kp I    &kp O
&kp Z      &kp X         &kp C          &kp D    &kp V             &kp ESCAPE           &out OUT_USB  &kp K      &kp H  &kp COMMA  &kp DOT  &kp SLASH
&kp LCTRL  &kp LEFT_WIN  &kp LG(SPACE)  &kp DEL  &lt 1 DOWN_ARROW  &lt 2 LC(SPACE)      &lt 3 TAB     &kp SPACE                             &kp ENTER
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        Number {
            bindings = <
&kp HOME          &kp LA(LC(UP_ARROW))  &kp UP_ARROW    &kp LA(DOWN_ARROW)  &kp END                               &kp MINUS      &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp GRAVE
&kp LC(LEFT)      &kp LEFT              &kp DOWN_ARROW  &kp RIGHT           &kp LC(RIGHT)  &trans      &trans     &kp NUMBER_0   &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp BACKSLASH
&kp LC(LG(LEFT))  &kp LG(LC(RIGHT))     &kp LA(LC(C))   &kp LA(DOWN)        &kp LC(LS(V))  &trans      &trans     &kp EQUAL      &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans
&trans            &trans                &trans          &trans              &trans         &trans      &kp ENTER  &kp BACKSPACE                                            &lt 6 ESCAPE
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        Vim {
            bindings = <
&kp LC(LS(F12))  &kp LS(LC(F11))  &kp LA(UP_ARROW)    &kp LC(P)      &kp PSCRN                                      &kp F12        &kp F7  &kp F8  &kp F9  &kp TILDE
&kp LC(A)        &kp LA(LEFT)     &kp LA(DOWN_ARROW)  &kp LA(RIGHT)  &kp LA(TAB)  &trans         &trans             &kp F11        &kp F4  &kp F5  &kp F6  &kp BACKSLASH
&kp LC(Z)        &kp LC(X)        &kp LC(C)           &kp LC(D)      &kp LC(V)    &kp ENTER      &trans             &kp F10        &kp F1  &kp F2  &kp F3  &kp GRAVE
&trans           &trans           &trans              &kp BACKSPACE  &trans       &trans         &kp LC(BACKSPACE)  &kp BACKSPACE                          &kp CAPS
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        Function {
            bindings = <
&kp LG(LEFT_ARROW)  &kp LG(RIGHT)  &kp LC(LS(RC(F12)))  &kp LC(LS(F11))     &kp PRINTSCREEN                      &kp U           &kp NUMBER_0      &kp K                 &kp DOLLAR             &trans
&kp LS(LC(TAB))     &kp LC(TAB)    &kp LA(UP_ARROW)     &kp LA(DOWN_ARROW)  &trans           &trans      &trans  &kp LEFT_BRACE  &kp H             &kp J                 &kp L                  &kp RIGHT_BRACE
&kp LA(SPACE)       &kp LA(LC(C))  &kp LC(LS(C))        &trans              &kp LC(LS(V))    &trans      &trans  &kp D           &kp LEFT_BRACKET  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACKET
&trans              &trans         &trans               &trans              &trans           &trans      &trans  &trans                                                                         &kp CLCK
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1  &none   &none   &none
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans    &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                            &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans        &trans        &trans        &trans                                 &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans        &trans        &trans        &trans  &trans            &trans       &trans        &trans        &trans        &trans        &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &bt BT_SEL 0      &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans        &trans        &trans        &trans  &trans            &trans       &trans                                                  &trans
            >;
        };
    };
};
