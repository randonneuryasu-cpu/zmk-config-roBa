#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100

&mt {
    flavor = "balanced";
    quick-tap-ms = <300>;
};

&lt {
    flavor = "balanced";
    quick-tap-ms = <300>;
};

&trackball {
    automouse-layer = <4>;
    scroll-layers = <5>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos {
        compatible = "zmk,combos";

        scroll {
            bindings = <&mo 5>;
            key-positions = <20 19>;
        };

        RtShift {
            bindings = <&kp RIGHT_SHIFT>;
            key-positions = <18 19>;
        };

        RtWin {
            bindings = <&kp RIGHT_WIN>;
            key-positions = <20 19>;
        };

        RtAlt {
            bindings = <&kp RIGHT_ALT>;
            key-positions = <17 18>;
        };

        RtCtl {
            bindings = <&kp RIGHT_CONTROL>;
            key-positions = <20 21>;
        };

        LtShift {
            bindings = <&kp LEFT_SHIFT>;
            key-positions = <13 12>;
        };

        LtWin {
            bindings = <&kp LWIN>;
            key-positions = <11 12>;
        };

        LtAlt {
            bindings = <&kp LEFT_ALT>;
            key-positions = <14 13>;
        };

        LtCtl {
            bindings = <&kp LEFT_CONTROL>;
            key-positions = <10 11>;
        };

        RtMB2 {
            bindings = <&mkp MB2>;
            key-positions = <7 20>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        scroll_up_down: behavior_sensor_rotate_mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            // 追加: スクロールのタップ時間を設定 (20ms)

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q        &kp W    &kp F          &kp P    &kp B                                              &kp J        &kp L  &kp U      &kp Y    &kp SEMICOLON
&kp A        &kp R    &kp S          &kp T    &kp G             &kp ESCAPE         &out OUT_BLE  &kp M        &kp N  &kp E      &kp I    &kp O
&kp Z        &kp X    &kp C          &kp D    &kp V             &kp RC(SPACE)      &out OUT_USB  &kp K        &kp H  &kp COMMA  &kp DOT  &kp SLASH
&kp LC(F10)  &kp SQT  &kp LG(SPACE)  &kp DEL  &lt 1 DOWN_ARROW  &lt 2 ENTER        &kp TAB       &lt 3 SPACE                             &kp EXCLAMATION
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        Number {
            bindings = <
&kp LA(UP_ARROW)    &kp HOME        &kp UP_ARROW        &kp END           &kp LA(DOWN_ARROW)                         &kp MINUS      &kp N7        &kp N8        &kp N9        &trans
&kp LC(LEFT_ARROW)  &kp LEFT_ARROW  &kp DOWN_ARROW      &kp RIGHT         &kp LC(RIGHT)       &trans      &trans     &kp N0         &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp SQT
&kp F12             &kp F11         &kp LA(LC(C))       &kp LG(UP_ARROW)  &kp LC(LS(V))       &trans      &trans     &kp EQUAL      &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans
&kp F2              &kp F9          &kp LG(DOWN_ARROW)  &trans            &trans              &trans      &kp ENTER  &kp BACKSPACE                                            &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        Function {
            bindings = <
&kp LA(UP_ARROW)  &kp HOME  &kp UP_ARROW   &kp END           &kp LA(DOWN)                          &kp F12            &kp F7  &kp F8  &kp F9  &kp LEFT_PARENTHESIS
&kp LC(LEFT)      &kp LEFT  &kp DOWN       &kp RIGHT         &kp LC(RIGHT)  &trans      &trans     &kp F11            &kp F4  &kp F5  &kp F6  &kp RIGHT_PARENTHESIS
&kp F12           &kp F11   &kp LC(LS(C))  &kp LG(UP_ARROW)  &kp LC(LS(V))  &trans      &trans     &kp F10            &kp F1  &kp F2  &kp F3  &kp LEFT_BRACKET
&kp F2            &kp F9    &kp LG(DOWN)   &trans            &trans         &trans      &kp ENTER  &kp RC(BACKSPACE)                          &lt 6 RIGHT_BRACKET
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        Atok {
            bindings = <
&kp LS(Q)        &kp LS(W)        &kp LS(F)    &kp LS(LC(F11))  &kp LS(B)                                 &kp F12  &kp F7  &kp F8  &kp F9  &kp PRINTSCREEN
&kp LS(LC(F12))  &kp LS(LC(F11))  &kp LC(F10)  &kp LC(F12)      &kp LS(G)      &trans             &trans  &kp F11  &kp F4  &kp F5  &kp F6  &kp ESCAPE
&kp LS(Z)        &kp LS(X)        &kp LS(C)    &kp LC(F10)      &kp LS(LC(V))  &kp LG(SPACE)      &trans  &kp F10  &kp F1  &kp F2  &kp F3  &kp DELETE
&trans           &trans           &trans       &trans           &trans         &trans             &trans  &trans                           &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1  &none   &none   &mkp MB3
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans    &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                            &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans        &trans        &trans        &trans                                 &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans        &trans        &trans        &trans  &trans            &trans       &trans        &trans        &trans        &trans        &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &bt BT_SEL 0      &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans        &trans        &trans        &trans  &trans            &trans       &trans                                                  &trans
            >;
        };

        Vim {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };
    };
};
