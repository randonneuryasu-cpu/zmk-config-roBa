#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100

&mt {
    flavor = "balanced";
    quick-tap-ms = <300>;
};

&lt {
    flavor = "balanced";
    quick-tap-ms = <300>;
};

&trackball {
    automouse-layer = <4>;
    scroll-layers = <5>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos {
        compatible = "zmk,combos";

        scroll {
            bindings = <&mo 5>;
            key-positions = <20 19>;
        };

        RtShift {
            bindings = <&kp RIGHT_SHIFT>;
            key-positions = <18 19>;
        };

        RtWin {
            bindings = <&kp RIGHT_WIN>;
            key-positions = <20 19>;
        };

        RtAlt {
            bindings = <&kp RIGHT_ALT>;
            key-positions = <17 18>;
        };

        RtCtl {
            bindings = <&kp RIGHT_CONTROL>;
            key-positions = <20 21>;
        };

        LtShift {
            bindings = <&kp LEFT_SHIFT>;
            key-positions = <13 12>;
        };

        LtWin {
            bindings = <&kp LWIN>;
            key-positions = <11 12>;
        };

        LtAlt {
            bindings = <&kp LEFT_ALT>;
            key-positions = <14 13>;
        };

        LtCtl {
            bindings = <&kp LEFT_CONTROL>;
            key-positions = <10 11>;
        };

        RtMB2 {
            bindings = <&mkp MB2>;
            key-positions = <7 20>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        scroll_up_down: behavior_sensor_rotate_mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            // 追加: スクロールのタップ時間を設定 (20ms)

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q           &kp W    &kp F          &kp P    &kp B                                              &kp J      &kp L  &kp U      &kp Y    &kp SEMICOLON
&kp A           &kp R    &kp S          &kp T    &kp G             &none              &out OUT_BLE  &kp M      &kp N  &kp E      &kp I    &kp O
&kp Z           &kp X    &kp C          &kp D    &kp V             &kp LC(SPACE)      &out OUT_USB  &kp K      &kp H  &kp COMMA  &kp DOT  &kp SLASH
&kp LEFT_SHIFT  &kp SQT  &kp LG(SPACE)  &kp DEL  &lt 1 DOWN_ARROW  &lt 2 ENTER        &lt 3 TAB     &kp SPACE                             &kp RIGHT_SHIFT
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        Number {
            bindings = <
&kp LA(UP_ARROW)  &kp HOME  &kp UP_ARROW        &kp END           &kp LA(DOWN_ARROW)                         &kp MINUS      &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp COLON
&kp LC(LEFT)      &kp LEFT  &kp DOWN_ARROW      &kp RIGHT         &kp LC(RIGHT)       &trans      &trans     &kp NUMBER_0   &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp SQT
&kp F12           &kp F11   &kp LA(LC(C))       &kp LG(UP_ARROW)  &kp LC(LS(V))       &trans      &trans     &kp EQUAL      &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans
&trans            &trans    &kp LG(DOWN_ARROW)  &trans            &trans              &trans      &kp ENTER  &kp BACKSPACE                                            &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        Vim {
            bindings = <
&kp LC(Q)        &kp LC(W)  &kp LC(F)      &kp LC(P)  &kp LC(B)                         &kp F12            &kp F7  &kp F8  &kp F9  &kp COLON
&kp LC(A)        &kp LC(R)  &kp LC(S)      &kp LC(T)  &kp LC(G)  &trans         &trans  &kp F11            &kp F4  &kp F5  &kp F6  &kp DOUBLE_QUOTES
&kp LC(Z)        &kp LC(X)  &kp LC(C)      &kp LC(D)  &kp LC(V)  &kp ENTER      &trans  &kp F10            &kp F1  &kp F2  &kp F3  &kp QUESTION
&kp PRINTSCREEN  &kp CLCK   &kp LS(LC(C))  &trans     &trans     &trans         &trans  &kp RC(BACKSPACE)                          &lt 6 ESCAPE
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        Function {
            bindings = <
&trans           &trans           &kp LEFT_PARENTHESIS   &kp LEFT_BRACKET   &kp PRINTSCREEN                      &kp RS(J)  &kp RS(L)  &kp RS(U)      &kp RS(Y)       &kp RS(SEMICOLON)
&trans           &trans           &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACKET  &kp BACKSLASH    &trans      &trans  &kp RS(M)  &kp RS(N)  &kp RS(E)      &kp RS(I)       &kp RS(O)
&kp LS(LC(F12))  &kp LS(LC(F11))  &kp LA(DOWN_ARROW)     &kp LA(UP_ARROW)   &kp GRAVE        &trans      &trans  &kp RS(K)  &kp RS(H)  &kp RS(COMMA)  &kp RS(PERIOD)  &kp RS(SLASH)
&trans           &trans           &trans                 &trans             &trans           &trans      &trans  &trans                                               &kp ESCAPE
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1  &none   &none   &none
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans    &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                            &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans        &trans        &trans        &trans                                 &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans        &trans        &trans        &trans  &trans            &trans       &trans        &trans        &trans        &trans        &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &bt BT_SEL 0      &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans        &trans        &trans        &trans  &trans            &trans       &trans                                                  &trans
            >;
        };

        Atok {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };
    };
};
